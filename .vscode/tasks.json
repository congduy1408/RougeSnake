{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RougeSnake",
            "type": "shell",
            "command": "C:\\raylib\\w64devkit\\bin\\mingw32-make.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build RougeSnake Debug",
            "type": "shell",
            "command": "C:\\raylib\\w64devkit\\bin\\mingw32-make.exe",
            "args": [
                "BUILD_MODE=DEBUG",
                "PROJECT_NAME=RougeSnakeDebug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean RougeSnake",
            "type": "shell",
            "command": "C:\\raylib\\w64devkit\\bin\\mingw32-make.exe",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
