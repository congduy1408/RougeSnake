{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch RougeSnake",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\RougeSnake.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\raylib\\w64devkit\\bin\\gdb.exe",
            "preLaunchTask": "Build RougeSnake",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
